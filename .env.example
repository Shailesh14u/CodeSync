# ==========================================
# CodeSync AI - Root Environment Configuration
# ==========================================

# Environment Mode: development | staging | production
NODE_ENV=development
APP_ENV=development
DEBUG=True

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Secret Key for JWT & Session Signing (generate using: openssl rand -hex 32)
SECRET_KEY=codesync-ai-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_USER=codesync_user
POSTGRES_PASSWORD=codesync_secure_password
POSTGRES_DB=codesync_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://codesync_user:codesync_secure_password@localhost:5432/codesync_db
# Fallback SQLite URL for quick local testing without PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///./codesync.db

# Redis Configuration (Optional for cache & job queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Real-time Collaboration Server (Hocuspocus / WebSockets)
COLLAB_SERVER_HOST=0.0.0.0
COLLAB_SERVER_PORT=1234
COLLAB_SERVER_URL=ws://localhost:1234

# AI Assistant Configuration
# Configurable providers: gemini | openai | anthropic | mock
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL_NAME=gemini-1.5-pro

# Code Execution Engine (Docker isolation)
DOCKER_CONTAINER_MEMORY_LIMIT=256m
DOCKER_CONTAINER_CPU_LIMIT=1.0
EXECUTION_TIMEOUT_SECONDS=10
